{
  "name": "paper-llama",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:backend && npm run test:frontend",
    "test:frontend": "vitest run",
    "test:backend": "node scripts/run_python.js -m pytest backend/tests/",
    "lint:backend": "node scripts/run_python.js -m ruff check backend/",
    "format:backend": "node scripts/run_python.js -m ruff format backend/",
    "lint:frontend": "eslint frontend/assets/",
    "format:frontend": "prettier --write frontend/assets/",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "format": "npm run format:backend && npm run format:frontend",
    "prepare": "husky",
    "build:css": "tailwindcss -i frontend/assets/input.css -o frontend/assets/style.css --minify",
    "watch:css": "tailwindcss -i frontend/assets/input.css -o frontend/assets/style.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "overrides": {
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vue/compiler-dom": "^3.5.30",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "vitest": "^4.1.11",
    "vue": "^3.5.30"
  }
}
